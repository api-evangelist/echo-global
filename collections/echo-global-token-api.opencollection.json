{
  "opencollection": "1.0.0",
  "info": {
    "name": "Echo Authorizer documents token API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Process to acquire a bearer token from Echo Global Logistics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://virtserver.swaggerhub.com/echogl/Echo_Authorizer_Public/1.0.0/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Endpoint to obtain a token - either used for the Client Credentials Flow or as the second leg of the Authorization Code Flow w/ or w/out PKCE"
        }
      ]
    }
  ],
  "bundled": true
}